# Replace food.example.com and enable only after obtaining the certificate.
server {
    listen 80;
    server_name food.example.com;
    location = /healthz { return 200 'ok'; }
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://$host$request_uri; }
}
server {
    listen 443 ssl;
    server_name food.example.com;
    ssl_certificate /etc/letsencrypt/live/food.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/food.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    root /usr/share/nginx/html;
    client_max_body_size 5m;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    location = /healthz { return 200 'ok'; }
    location ~ ^/(api|admin)/ {
        proxy_pass http://backend:8000;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
    location /static/ { alias /srv/static/; }
    location /media/ { alias /srv/media/; add_header Content-Security-Policy "default-src 'none'" always; add_header X-Content-Type-Options nosniff always; }
    location / { try_files $uri $uri/ /index.html; }
}
